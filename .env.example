# =============================================================================
# Servidor (lido por dotenv em server.ts)
# =============================================================================

# Chave do Gemini. Nunca vai para o bundle do frontend.
GEMINI_API_KEY=

# Origens do navegador autorizadas a chamar a API (CORS).
# Origens exatas, ou um `*` por origem. Em produção não inclua localhost.
# Ex.: https://teacherreader.vercel.app,https://teacherreader-*-fbsagats-projects.vercel.app
CORS_ORIGINS=http://localhost:3000

# true quando o frontend é hospedado separadamente (Vercel + API na VPS).
API_ONLY=false

# Porta do Express no processo local. Na VPS o compose fixa 3000 internamente
# (publicado em 127.0.0.1:3110), então não defina PORT no .env de produção.
PORT=3000

# =============================================================================
# Frontend (build da Vite — precisa de novo deploy ao mudar)
# =============================================================================

# Deixe vazio no dev (mesma origem). Na Vercel use a URL pública da API.
# Trocar este valor exige editar o connect-src do CSP em vercel.json.
VITE_API_BASE_URL=

# =============================================================================
# Operação
# =============================================================================

# Desliga HMR e file watching (usado pelo AI Studio durante edições).
DISABLE_HMR=false
