# Server-side AI & Voice Configuration
# Gemini API key (never expose it in the frontend).
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call this API (CORS).
# Example: https://teacherreader.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Set to true when the frontend is hosted separately (Vercel + VPS API).
API_ONLY=false

# Port used by the Express server (the VPS compose file binds 127.0.0.1:3100).
PORT=3000
