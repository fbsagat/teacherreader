# Server-side AI & Voice Configuration
# Gemini API key (never expose it in the frontend).
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call this API (CORS).
# Exact origins, or one `*` for subdomains. Keep previews scoped to the Vercel
# team so nobody else can spend your Gemini quota from a lookalike domain:
# Example: https://teacherreader.vercel.app,https://teacherreader-*-fbsagats-projects.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Set to true when the frontend is hosted separately (Vercel + VPS API).
API_ONLY=false

# Port used by the Express server (the VPS compose file binds 127.0.0.1:3110).
PORT=3000

# Frontend (Vite) build-time API base.
# Leave empty for local dev (same origin); on Vercel use the public backend URL.
VITE_API_BASE_URL=
